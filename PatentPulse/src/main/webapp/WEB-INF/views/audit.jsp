<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %><div class="page-heading"><div><div class="eyebrow">ACCOUNTABILITY, EVENT BY EVENT</div><h1>Audit trail<span class="teal">.</span></h1><p>The latest 200 application events. This log is not an externally anchored, tamper-proof ledger.</p></div></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>TIME (UTC)</th><th>ACTOR</th><th>ACTION / TARGET</th><th>DETAILS</th></tr></thead><tbody><c:forEach items="${events}" var="event"><tr><td class="mono small"><c:out value="${event.created_at}"/></td><td><c:out value="${event.actor_name}"/></td><td><strong><c:out value="${event.action}"/></strong><small><c:out value="${event.target_type}"/> #${event.target_id}</small></td><td class="audit-detail"><c:out value="${event.details}"/></td></tr></c:forEach></tbody></table></div><c:if test="${empty events}"><div class="empty-state">No events recorded yet.</div></c:if></section><%@ include file="footer.jspf" %>