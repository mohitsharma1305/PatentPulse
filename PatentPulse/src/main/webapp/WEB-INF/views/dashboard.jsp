<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>
<div class="page-heading"><div><div class="eyebrow">IDEAS, WITH A HISTORY</div><h1>Your research ledger<span class="teal">.</span></h1><p>One place for your drafts, fingerprints, and peer-reviewed versions.</p></div><a class="btn primary" href="${pageContext.request.contextPath}/app/new">+ New submission</a></div>
<section class="hero-card"><div><span class="hero-label">A RECORD THAT MOVES WITH YOUR RESEARCH</span><h2>Build the idea.<br>Keep the evidence.</h2><p>Capture a version, preserve its fingerprint, and bring reviewers into the process.</p><a href="${pageContext.request.contextPath}/app/new">Start a research record <span>↗</span></a></div><div class="fingerprint-art" aria-hidden="true"><div class="fingerprint-rings"><span>SHA<br><b>256</b></span></div><span class="floating-label">● INTEGRITY FIRST</span></div></section>
<div class="stats"><article><span>Total research records</span><strong>${totalCount}</strong><small>Your complete workspace</small></article><article><span>Draft blueprints</span><strong>${draftCount}</strong><small>Ready for your next step</small></article><article><span>Internally reviewed</span><strong>${reviewedCount}</strong><small>Latest versions with two approvals</small></article></div>
<section class="panel"><div class="panel-heading"><div><h2>Research records</h2><p>Latest version of each project</p></div><span class="subtle-tag">PRIVATE BY DEFAULT</span></div><form method="get" action="${pageContext.request.contextPath}/app/dashboard" class="toolbar"><label class="sr-only" for="search">Search research</label><input id="search" name="q" value="<c:out value='${param.q}'/>" placeholder="Search title or research field…" maxlength="180"><label class="sr-only" for="status">Status</label><select name="status" id="status"><option value="">All statuses</option><c:forEach items="${['DRAFT','SUBMITTED','IN_REVIEW','INTERNALLY_REVIEWED','NEEDS_REVISION']}" var="state"><option value="${state}" ${param.status == state ? 'selected' : ''}><c:out value="${fn:replace(state,'_',' ')}"/></option></c:forEach></select><button class="btn secondary" type="submit">Filter</button></form>
<div class="table-wrap"><table><thead><tr><th>RESEARCH / FIELD</th><th>VERSION</th><th>STATUS</th><th>RECORDED (UTC)</th><th></th></tr></thead><tbody><c:forEach items="${records}" var="r"><tr><td><strong><c:out value="${r.title}"/></strong><small><c:out value="${r.field}"/></small></td><td>${empty r.version_id ? '—' : 'v'}<c:out value="${r.version_number}"/></td><td><span class="badge ${empty r.status ? 'DRAFT' : r.status}"><c:out value="${empty r.status ? 'DRAFT' : fn:replace(r.status,'_',' ')}"/></span></td><td class="mono small"><c:out value="${empty r.submitted_at ? 'Not submitted' : r.submitted_at}"/></td><td><a class="table-link" href="${pageContext.request.contextPath}/app/${empty r.version_id ? 'new' : 'document'}?id=${empty r.version_id ? r.id : r.version_id}">Open ↗</a></td></tr></c:forEach></tbody></table></div>
<c:if test="${empty records}"><div class="empty-state"><span class="empty-icon">+</span><h3>No research records here yet</h3><p>Create your first blueprint or adjust your filters.</p><a class="btn secondary" href="${pageContext.request.contextPath}/app/new">Create a blueprint →</a></div></c:if></section>
<%@ include file="footer.jspf" %>
