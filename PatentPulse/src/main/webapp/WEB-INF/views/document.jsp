<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %><div class="page-heading"><div><div class="eyebrow">RESEARCH RECORD / PP-${doc.blueprint_id} / VERSION ${doc.version_number}</div><h1 class="document-title"><c:out value="${doc.title}"/></h1><p><c:out value="${doc.field}"/> <span class="separator">/</span> Submitted by <c:out value="${doc.owner_name}"/></p></div><span class="badge ${doc.status}"><c:out value="${fn:replace(doc.status,'_',' ')}"/></span></div>
<c:if test="${param.submitted == '1'}"><div class="alert success">Version recorded. Its file fingerprint and metadata are now fixed.</div></c:if>
<div class="document-actions"><a class="btn primary" href="${pageContext.request.contextPath}/file?id=${doc.id}">↓ Download original</a><c:if test="${sessionScope.user.id == doc.owner_id}"><a class="btn secondary" href="${pageContext.request.contextPath}/app/new?id=${doc.blueprint_id}">+ New version</a></c:if></div>
<div class="two-col"><div><section class="panel detail-panel"><div class="panel-heading"><h2>Research overview</h2><span class="subtle-tag">VERSION ${doc.version_number}</span></div><p class="preserve"><c:out value="${doc.summary}"/></p><div class="metadata"><div><small>ORIGINAL FILE</small><strong><c:out value="${doc.original_name}"/></strong></div><div><small>FILE SIZE</small><strong>${doc.size_bytes} bytes</strong></div><div><small>SERVER TIMESTAMP (UTC)</small><strong class="mono"><c:out value="${doc.submitted_at}"/></strong></div><div><small>RECORD IDENTIFIER</small><strong>PP-${doc.blueprint_id}-V${doc.version_number}</strong></div></div><div class="hash-box"><div><span class="status-dot"></span> SHA-256 FINGERPRINT <button class="text-button" type="button" data-copy="hash-value">Copy</button></div><code id="hash-value"><c:out value="${doc.sha256}"/></code></div></section>
<section class="panel detail-panel"><div class="panel-heading"><div><h2>Verify a file</h2><p>Compare any local copy with this recorded version.</p></div><span class="outline-icon">✓</span></div><c:if test="${sessionScope.verification.id == doc.id}"><div class="alert ${sessionScope.verification.result == 'MATCH' ? 'success' : 'error'}"><strong><c:out value="${sessionScope.verification.result}"/></strong> — ${sessionScope.verification.result == 'MATCH' ? 'The compared file matches the recorded fingerprint.' : 'The compared file differs from the recorded fingerprint.'}</div><c:remove var="verification" scope="session"/></c:if><form action="${pageContext.request.contextPath}/app/verify" method="post" enctype="multipart/form-data" class="verify-form"><%@ include file="csrf.jspf" %><input type="hidden" name="versionId" value="${doc.id}"><label class="sr-only" for="comparison">File to verify</label><input id="comparison" type="file" name="comparison" required><button class="btn primary" type="submit">Check integrity</button></form></section>
<section class="panel detail-panel"><div class="panel-heading"><h2>Peer review</h2><span class="subtle-tag">INTERNAL EVALUATION</span></div><c:forEach items="${reviews}" var="review" varStatus="loop"><article class="review-item"><div><strong>${sessionScope.user.admin ? 'Reviewer: ' : 'Reviewer '}<c:out value="${sessionScope.user.admin ? review.reviewer_name : loop.count}"/></strong><span class="badge ${review.decision == 'REJECT' ? 'NEEDS_REVISION' : 'IN_REVIEW'}"><c:out value="${empty review.decision ? 'PENDING' : review.decision}"/></span></div><p class="preserve"><c:out value="${empty review.comments ? 'Awaiting evaluation.' : review.comments}"/></p><small class="muted"><c:out value="${review.voted_at}"/></small></article></c:forEach><c:if test="${empty reviews}"><p class="muted">No reviewers assigned yet. An administrator will assign this version.</p></c:if>
<c:if test="${canVote}"><form class="review-form" method="post" action="${pageContext.request.contextPath}/app/review/vote"><%@ include file="csrf.jspf" %><input type="hidden" name="versionId" value="${doc.id}"><label for="comments">Your evaluation</label><textarea id="comments" name="comments" required minlength="10" maxlength="3000" rows="4" placeholder="Comment on the clarity, completeness, and research approach."></textarea><label for="decision">Decision</label><select name="decision" id="decision"><option value="APPROVE">Approve this version</option><option value="REJECT">Request revision</option></select><p class="help">Decisions are final for this version. Internal review does not certify novelty or patentability.</p><button class="btn primary" type="submit">Submit evaluation →</button></form></c:if>
<c:if test="${sessionScope.user.admin and doc.status != 'INTERNALLY_REVIEWED' and doc.status != 'NEEDS_REVISION' and fn:length(reviews) < 2}"><form class="review-form" method="post" action="${pageContext.request.contextPath}/app/admin/assign"><%@ include file="csrf.jspf" %><input type="hidden" name="versionId" value="${doc.id}"><label for="reviewer">Assign a reviewer</label><select name="reviewerId" id="reviewer" required><option value="">Choose an active reviewer</option><c:forEach items="${reviewers}" var="person"><c:if test="${person.id != doc.owner_id}"><option value="${person.id}"><c:out value="${person.name}"/> · <c:out value="${person.email}"/></option></c:if></c:forEach></select><button class="btn secondary" type="submit">Assign reviewer</button></form></c:if></section></div>
<aside class="side-notes"><section class="panel note-panel"><h3>Version history</h3><p class="muted">Each version keeps its own file, fingerprint, and review outcome.</p><div class="timeline"><c:forEach items="${history}" var="h"><a class="timeline-item ${h.id == doc.id ? 'current' : ''}" href="${pageContext.request.contextPath}/app/document?id=${h.id}"><span class="timeline-dot"></span><strong>Version ${h.version_number} ${h.id == doc.id ? '· viewing' : ''}</strong><small><c:out value="${h.submitted_at}"/></small><small><c:out value="${fn:replace(h.status,'_',' ')}"/></small></a></c:forEach></div></section><div class="info-note">This is an internal research record. A matching fingerprint confirms matching file contents; it does not establish authorship, novelty, or legal IP ownership.</div></aside></div><%@ include file="footer.jspf" %>
