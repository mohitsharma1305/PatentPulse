<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %><div class="page-heading"><div><div class="eyebrow">MAKE YOUR NEXT IDEA TRACEABLE</div><h1>${empty draft ? 'New research record' : 'Research workspace'}<span class="teal">.</span></h1><p>Save your draft now, or upload a file to record an immutable version.</p></div></div>
<c:if test="${param.saved == '1'}"><div class="alert success">Draft saved. No fingerprint is generated until a file is submitted.</div></c:if>
<div class="two-col"><section class="panel form-panel"><form method="post" action="${pageContext.request.contextPath}/app/submit" enctype="multipart/form-data" id="research-form"><%@ include file="csrf.jspf" %><input type="hidden" name="blueprintId" value="<c:out value='${draft.id}'/>"><h2>01 / Research details</h2>
<label for="title">Research title</label><input id="title" name="title" required minlength="3" maxlength="180" value="<c:out value='${draft.title}'/>" placeholder="Give your research a clear, specific title">
<label for="field">Field of study</label><input id="field" name="field" list="fields" required maxlength="80" value="<c:out value='${draft.field}'/>" placeholder="e.g. Cybersecurity"><datalist id="fields"><option>Cybersecurity</option><option>Artificial Intelligence</option><option>Data Science</option><option>Computer Science</option><option>Engineering</option><option>Other</option></datalist>
<label for="summary">Research summary</label><textarea id="summary" name="summary" rows="7" required minlength="20" maxlength="10000" placeholder="Explain the problem, your approach, and what this version contains."><c:out value="${draft.summary}"/></textarea><small class="help">20–10,000 characters. Only authorized users can access this record.</small>
<h2 class="section-gap">02 / Attach this version</h2><div class="upload-zone"><span class="upload-symbol">↑</span><strong>Choose your research file</strong><p>PDF, text, or source code · Up to 10 MB</p><input id="document" type="file" name="document" accept=".pdf,.txt,.java,.py,.js,.c,.cpp,.h,.md,.json,.csv"><span class="help">Files are stored privately and downloaded as attachments.</span></div>
<div class="form-actions"><c:if test="${not hasVersions}"><button type="submit" formaction="${pageContext.request.contextPath}/app/draft" class="btn secondary" data-action="draft">Save draft</button></c:if><button type="submit" class="btn primary" data-action="submit">Record new version →</button></div></form></section><aside class="side-notes"><div class="panel note-panel"><span class="step-circle">01</span><h3>A fingerprint of this file</h3><p>SHA-256 is computed from the exact uploaded bytes. Even a small edit produces a different fingerprint.</p><hr><span class="step-circle">02</span><h3>A version you can revisit</h3><p>Submitted content is immutable in the application. Future edits become a new version with a separate review.</p><hr><span class="step-circle">03</span><h3>A clear review trail</h3><p>Two assigned reviewers can approve this version. One rejection requests a new revision.</p></div><div class="info-note">An internal timestamp records when this server received the file. It is not a trusted third-party timestamp or proof of invention.</div></aside></div><%@ include file="footer.jspf" %>
