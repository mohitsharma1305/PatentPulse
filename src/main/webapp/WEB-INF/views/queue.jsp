<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %><div class="page-heading"><div><div class="eyebrow">${sessionScope.user.admin ? 'OVERSIGHT & ASSIGNMENTS' : 'YOUR REVIEW WORKSPACE'}</div><h1>${sessionScope.user.admin ? 'All submissions' : 'Review queue'}<span class="teal">.</span></h1><p>${sessionScope.user.admin ? 'Assign reviewers and follow every submitted version.' : 'Evaluate the research versions assigned to you.'}</p></div></div><section class="panel"><div class="panel-heading"><h2>Submitted versions</h2><span class="subtle-tag">${fn:length(records)} RECORDS</span></div><div class="table-wrap"><table><thead><tr><th>RESEARCH</th><th>VERSION</th><th>STATUS</th><th>${sessionScope.user.admin ? 'RESEARCHER' : 'YOUR DECISION'}</th><th></th></tr></thead><tbody><c:forEach items="${records}" var="r"><tr><td><strong><c:out value="${r.title}"/></strong><small><c:out value="${r.field}"/></small></td><td>v${r.version_number}</td><td><span class="badge ${r.status}"><c:out value="${fn:replace(r.status,'_',' ')}"/></span></td><td><c:out value="${sessionScope.user.admin ? r.owner_name : (empty r.decision ? 'Not submitted' : r.decision)}"/></td><td><a class="table-link" href="${pageContext.request.contextPath}/app/document?id=${r.id}">Open ↗</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty records}"><div class="empty-state"><span class="empty-icon">◎</span><h3>You're all caught up</h3><p>Submitted or assigned versions will appear here.</p></div></c:if></section><%@ include file="footer.jspf" %>
