<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %><div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>People & roles<span class="teal">.</span></h1><p>Manage researcher and reviewer access. Admin accounts are protected.</p></div></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>PERSON</th><th>CURRENT ROLE</th><th>ACCOUNT</th><th>MANAGE ACCESS</th></tr></thead><tbody><c:forEach items="${users}" var="person"><tr><td><strong><c:out value="${person.name}"/></strong><small><c:out value="${person.email}"/></small></td><td><c:out value="${person.role}"/></td><td><span class="badge ${person.active ? 'IN_REVIEW' : 'DRAFT'}">${person.active ? 'ACTIVE' : 'DISABLED'}</span></td><td><c:if test="${person.role != 'ADMIN'}"><form class="inline-form" method="post" action="${pageContext.request.contextPath}/app/admin/user"><%@ include file="csrf.jspf" %><input type="hidden" name="userId" value="${person.id}"><select name="role" aria-label="Role for user ${person.id}"><option value="RESEARCHER" ${person.role == 'RESEARCHER' ? 'selected' : ''}>Researcher</option><option value="REVIEWER" ${person.role == 'REVIEWER' ? 'selected' : ''}>Reviewer</option></select><select name="active" aria-label="Account status for user ${person.id}"><option value="true" ${person.active ? 'selected' : ''}>Active</option><option value="false" ${not person.active ? 'selected' : ''}>Disabled</option></select><button class="btn secondary" type="submit">Save</button></form></c:if><c:if test="${person.role == 'ADMIN'}"><span class="muted">Protected administrator</span></c:if></td></tr></c:forEach></tbody></table></div></section><%@ include file="footer.jspf" %>
